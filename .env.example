# PowerShell: set these as $env:AI_CHAT_... before launching Uvicorn.
# This example is documentation; the application does not auto-load .env files.
AI_CHAT_PROVIDER=mock
AI_CHAT_DATABASE_PATH=local_data/chat.sqlite3
AI_CHAT_MAX_HISTORY_TURNS=10
AI_CHAT_MAX_CONTEXT_CHARACTERS=16000
AI_CHAT_REQUEST_TIMEOUT_SECONDS=20

# Enable http only after supplying your own compatible API configuration.
# AI_CHAT_PROVIDER=http
# AI_CHAT_BASE_URL=https://your-provider.example/v1
# AI_CHAT_MODEL=your-model-id
# AI_CHAT_API_KEY=replace-locally-never-commit
